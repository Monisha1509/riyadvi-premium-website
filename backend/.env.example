NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/riyadvi_premium
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-strong-password
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Legacy AI_API_KEY is accepted as a fallback, but GEMINI_API_KEY is preferred.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=info@riyadvisoftwaretechnologies.com
